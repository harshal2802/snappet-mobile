<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light app theme: the pre-Compose window frame matches the Pulse paper background. -->
    <style name="Theme.Snappet" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/snappet_background_light</item>
    </style>

    <!-- Cold-start splash (AndroidX SplashScreen): the Pulse mark on brand coral in both
         modes, handing off to Theme.Snappet (issue #96). -->
    <style name="Theme.Snappet.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/snappet_brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Snappet</item>
    </style>
</resources>
