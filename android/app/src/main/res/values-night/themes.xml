<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark app theme: a dark parent + dark window background so a cold start in dark
         mode never flashes a white frame (issue #96). -->
    <style name="Theme.Snappet" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/snappet_background_dark</item>
    </style>
</resources>
