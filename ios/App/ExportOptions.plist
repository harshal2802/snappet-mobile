<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- App Store distribution export for `xcodebuild -exportArchive`. Automatic signing lets Xcode mint
     the App Store provisioning profiles for the app + watch + widget under the paid team. -->
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <key>teamID</key>
    <string>NFUS5W8QC6</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <key>uploadSymbols</key>
    <true/>
    <key>destination</key>
    <string>export</string>
    <!-- We control the build number explicitly (no auto-increment surprises). -->
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
</dict>
</plist>
