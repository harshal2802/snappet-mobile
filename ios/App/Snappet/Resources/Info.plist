<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Snappet</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- snappet:// deep links (#75): a shared climb's QR code (snappet://kilter/climb/<uuid>)
	     scanned with the iOS Camera — or opened from Safari/another app — launches Snappet on
	     that climb. Parsed by SnappetDeepLink (KilterDeepLink.swift) via RootShell.onOpenURL.
	     Registered HERE (the checked-in plist project.yml points INFOPLIST_FILE at) — never in
	     the generated .xcodeproj. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.snappet.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>snappet</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Snappet connects over Bluetooth to your heart-rate band (chest straps, Polar, Garmin, and similar) for live heart rate during a workout, and to a Kilter Board to light up climbs. Everything stays on your device.</string>
	<!-- ONE camera key covering both uses — this dict briefly carried two
	     NSCameraUsageDescription entries (receipts + QR), and a plist dict keeps only one. -->
	<key>NSCameraUsageDescription</key>
	<string>Snappet uses the camera to scan a receipt (to pull out the line items and split them) and to scan a Kilter climb's QR code a friend shared. Everything is processed on your device; nothing is stored or uploaded.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Snappet reads your workout heart rate to find your most intense moments and build a highlight reel.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Snappet does not write health data.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Snappet saves your finished highlight reel back to your library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Snappet finds the photos and videos you shot during your workout to build your reel, and — only when you ask — saves your edits over the original or removes a clip from your library.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
