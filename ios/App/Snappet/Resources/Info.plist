<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Snappet</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>UILaunchScreen</key>
    <dict/>

    <!-- Usage strings: required for App Store review (#60 §7). Value-first wording. -->
    <key>NSHealthShareUsageDescription</key>
    <string>Snappet reads your workout heart rate to find your most intense moments and build a highlight reel.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>Snappet does not write health data.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Snappet finds the photos and videos you shot during your workout so it can build your reel automatically.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Snappet saves your finished highlight reel back to your library.</string>
</dict>
</plist>
