# App Store screenshots via the SnappetScreenshots UI test. 6.9" iPhone (App Store's largest required
# size). The flagship reels are device-only (no HealthKit/Photos on the sim) — run the same test on a
# connected device to capture them.
devices(["iPhone 17 Pro Max"])
languages(["en-US"])

scheme("Snappet")
only_testing(["SnappetUITests/SnappetScreenshots"])

output_directory("./screenshots")
clear_previous_screenshots(true)
concurrent_simulators(false)
stop_after_first_error(false)
skip_open_summary(true)
override_status_bar(true)
