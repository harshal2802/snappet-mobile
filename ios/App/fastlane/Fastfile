default_platform(:ios)

# Uploads to TestFlight using an App Store Connect API key. The key is read from env at runtime
# (never committed): ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (path to the .p8).
platform :ios do
  def asc_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house: false
    )
  end

  desc "Archive (Release) + upload to TestFlight"
  lane :beta do
    api_key = asc_key
    build_app(
      project: "Snappet.xcodeproj",
      scheme: "Snappet",
      configuration: "Release",
      export_method: "app-store",
      export_options: "ExportOptions.plist",
      output_directory: "build",
      output_name: "Snappet.ipa",
      xcargs: "-allowProvisioningUpdates"
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,   # don't block on Apple's processing
      distribute_external: false                  # internal testing only (no review needed)
    )
  end

  desc "Capture App Store screenshots (iPhone + iPad) via fastlane snapshot — see fastlane/Snapfile"
  lane :screenshots do
    capture_screenshots   # reads fastlane/Snapfile; runs only SnappetUITests/SnappetSnapshotTests
  end
end
