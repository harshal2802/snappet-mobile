*.iml
.gradle/
local.properties
.idea/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
android/app/release/

# ── Secrets / signing (NEVER commit) ──
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
*.cer
.env
.env.*
secrets.xcconfig
google-services.json
GoogleService-Info.plist

