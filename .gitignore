*.log
node_modules/
.venv/
__pycache__/
.claude/

# SwiftPM build artifacts
ios/HighlightEngine/.build/
.build/

# XcodeGen output (regenerate from project.yml)
ios/App/*.xcodeproj

# Local scratch / untracked notes (token-usage reports, drafts, etc.)
tmp/
docs/walkthroughs/video-studio-walkthrough-fullres.mp4
ios/App/build/
ios/App/fastlane/README.md
